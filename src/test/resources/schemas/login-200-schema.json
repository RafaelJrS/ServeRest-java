{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contrato de Login com Sucesso (200)",
  "type": "object",
  "required": [
    "message",
    "authorization"
  ],
  "properties": {
    "message": {
      "type": "string"
    },
    "authorization": {
      "type": "string",
      "pattern": "^Bearer\\s+.+$"
    }
  },
  "additionalProperties": false
}

